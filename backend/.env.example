PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_business_inbox
# Use a long random secret (e.g. openssl rand -base64 48). Never commit real values.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# Optional OpenAI fallback (currently unused by active service)
OPENAI_API_KEY=
OPENAI_MODEL=
# Seed scripts: ALLOW_SEED=true required for production/remote; ALLOW_DESTRUCTIVE_SEED=true for root seed.js
